rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Public read for app content
    match /announcements/{doc} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /pastorsCorner/{doc} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /youth/{doc} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /sundaySchool/{doc} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /gallery/{doc} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /appSettings/{doc} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
